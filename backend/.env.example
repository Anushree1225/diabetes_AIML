# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required: Your Google AI Studio API key
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Required: Groq API key (chatbot only — get from console.groq.com)
GROQ_API_KEY=

# Optional: Groq model to use (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Override the ML model file path (default: app/models/diabetes_model.joblib)
ML_MODEL_PATH=
